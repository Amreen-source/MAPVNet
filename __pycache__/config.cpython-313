"""
MAPVNet Global Configuration
============================

Central configuration for dataset paths, model checkpoints,
training hyperparameters, preprocessing settings, confidence
handling, and MAPVNet agent configuration.

The dataset statistics and experimental settings follow the
MAPVNet manuscript.
"""

import os
from pathlib import Path


